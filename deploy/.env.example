# Every environment variable the live path reads. Copy to .env and fill in
# what you need; nothing here has a value, on purpose.
#
#   cp deploy/.env.example deploy/.env
#   docker compose -f deploy/docker-compose.yml up -d
#
# The three at the top are required. Everything below them has a default
# that works, and is listed so you can see what exists.

# ---- required ----------------------------------------------------------

# Postgres. The compose file sets this for the dqengine service from
# POSTGRES_PASSWORD below; set it yourself when you run outside compose.
DATABASE_URL=
# Redis. The tick, the order path and the feed meet here.
REDIS_URL=
# The key broker credentials are encrypted under (Fernet over sha256 of
# this). Lose it and no stored connection decrypts. `dqengine live` writes
# ~/.dqengine_secret on a first run if this is unset and the database holds
# no connections.
DQENGINE_SECRET=

# ---- the database's own password (compose only) ------------------------

# Used by the postgres service and by the DATABASE_URL compose builds.
POSTGRES_PASSWORD=

# ---- market data -------------------------------------------------------

# Alpaca market data: history for the warm-up, today's minutes over REST,
# and the bundled websocket feed. Free to create at alpaca.markets.
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
# Which tape the websocket feed streams: iex (free, one exchange) or sip
# (full market, paid). Default: iex. History is SIP either way.
APCA_API_DATA_FEED=

# ---- broker credentials ------------------------------------------------

# The Alpaca paper adapter reads these, or the APCA_ pair above.
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
# Any other broker: its credential fields as one JSON object. The field
# names are in that adapter's own README.
DQENGINE_BROKER_CREDS=

# ---- where the bars live -----------------------------------------------

# The curated bar store `dqengine backtest` and `dqengine data fetch` read.
# Default: ./data
DQENGINE_DATA_ROOT=
# Where the live path writes the zips a replay reads. Must not be
# DQENGINE_DATA_ROOT: the live overlay is raw-price feed data and the
# exporter refuses to write it over a curated store. `dqengine live`
# defaults it to ./live-data.
PYDATA_ROOT=

# ---- how your algorithm runs -------------------------------------------

# sandbox (one container per run) or inproc (in this process, no
# isolation). `dqengine live` picks inproc unless you set this.
PYRUN_ENGINE_MODE=
# Must be 1 for inproc. It is an acknowledgement, not a switch.
PYRUN_INPROC_ALLOWED=
# The hosted topology's sandbox service. Setting it refuses inproc.
PYRUNNER_URL=
# Shared secret for that service.
PYRUN_SVC_TOKEN=

# ---- sandbox mode only (ignored under inproc) --------------------------

# The sandbox image to run. Default: pyrunner:dev
PYRUN_IMAGE=
# Per-container limits. Defaults: 1 cpu, 2g memory, 256m /tmp, 180s.
PYRUN_CPUS=
PYRUN_MEM=
PYRUN_TMP_MB=
PYRUN_TIMEOUT_S=
# How many runs may be in flight at once. Default: 2
PYRUN_MAX_CONCURRENT=
# Containers kept pre-started so a run does not pay ~10s of start. Default: 0
PYRUN_WARM_POOL=
# The uid user code runs as inside the image. Default: 1500
PYRUN_SANDBOX_UID=
# Where per-run workdirs are made; needed when the sandbox is a sibling
# container and the bind must be a host-visible path.
PYRUN_WORK_BASE=
# How the driver talks to a long-lived engine container: socket, file or
# auto. Default: auto
PYRUN_ENGINE_TRANSPORT=
# How often the driver polls for an engine's response, in seconds.
# Default: 0.001
PYRUN_ENGINE_POLL_S=
# Build context for the sandbox image, inside the sandbox service.
PYRUN_SANDBOX_CONTEXT=
# The sandbox service's own bar mount and image/pool upkeep.
PYRUN_DATA_DIR=
PYRUN_ENSURE_IMAGE=
PYRUN_POOL_HEARTBEAT_S=
# Where dqengine.runtime lives for a process that cannot infer it.
ENGINE_ROOT=

# ---- order submission --------------------------------------------------

# How many orders are sent in parallel in one sweep. Default: 6
SUBMIT_POOL=
# Milliseconds between submissions in a batch. Default: 0
SUBMIT_STAGGER_MS=

# ---- diagnostics -------------------------------------------------------

# 0 turns off the reconcile-frame recorder (one row per sweep, 30-day
# retention, quiet sweeps sampled). Default: on.
DQENGINE_RECORD_RECONCILE=
# 0 turns off the backtester's quiet-bar fast path. Default: on.
DQENGINE_FAST_PATH=
# Set by the manifest pass itself so history() returns empty; not for you.
DQENGINE_MANIFEST_PASS=
# How long a long-lived engine waits idle before exiting, in seconds, and
# how often it polls. Defaults: 14400 and 0.001.
DQENGINE_SERVE_IDLE_S=
DQENGINE_SERVE_POLL_S=
# How long a pre-warmed sandbox container waits for work. Default: 1800
DQENGINE_WARM_IDLE_S=
